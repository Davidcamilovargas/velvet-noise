# Copia este archivo como .env en esta misma carpeta (frontend/.env).
# Todas las variables que Vite expone al navegador deben empezar con VITE_.
#
# Si este archivo no se copia, la app igual arranca (api.ts trae un valor
# por defecto para desarrollo local: http://localhost:4000/api), pero es
# mejor tenerlo explícito — y es obligatorio si el backend no corre en
# localhost:4000 (por ejemplo, contra un backend ya desplegado).

VITE_API_URL=http://localhost:4000/api

# Llave PÚBLICA de Wompi (la privada nunca va en el frontend). Vacía = el
# checkout con pago en línea no abre el widget, el resto de la tienda
# funciona igual.
VITE_WOMPI_PUBLIC_KEY=

# WhatsApp de la tienda: indicativo + número, solo dígitos (ej. 573001234567).
# Vacío = no se muestra el botón de WhatsApp.
VITE_WHATSAPP_NUMBER=

# Correo de contacto que se muestra en Contacto y en las políticas.
VITE_CONTACT_EMAIL=
