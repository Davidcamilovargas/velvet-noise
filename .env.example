# =============================================================================
# VELVET NOISE — Variables de entorno
# Copia este archivo como .env en backend/ (y ajusta lo que aplique en
# frontend/.env para variables públicas VITE_*). NUNCA subas el .env real
# a git — ya está ignorado en .gitignore.
# =============================================================================

# ---- Entorno -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---- Base de datos -------------------------------------------------------
# Desarrollo local: la que expone database/docker-compose.yml
DATABASE_URL=postgresql://tienda_user:tienda_pass@localhost:5432/tienda_virtual?schema=public
# Usadas solo por docker-compose.yml de la raíz (despliegue con Docker
# Compose) para levantar el propio contenedor de Postgres — deben coincidir
# con las credenciales de la URL de arriba. No aplican si usas un Postgres
# gestionado externo (Railway/Render/Neon/Supabase): en ese caso deja estas
# tres vacías y solo completa DATABASE_URL con la URL que te dé el proveedor.
POSTGRES_USER=tienda_user
POSTGRES_PASSWORD=tienda_pass
POSTGRES_DB=tienda_virtual

# ---- Autenticación (JWT) --------------------------------------------------
# Genera valores fuertes con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Pasarela de pagos: Wompi ---------------------------------------------
# Obtén tus llaves en https://comercios.wompi.co (modo Sandbox para pruebas)
# Llave pública de prueba de ejemplo (no funcional, solo formato): pub_test_XXXXXXXXXXXX
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Secreto de eventos: para verificar la firma de los webhooks
WOMPI_EVENTS_SECRET=
# Secreto de integridad: para firmar la referencia de la transacción desde el frontend
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ---- Emails (Resend) -------------------------------------------------------
# Crea una cuenta y API key en https://resend.com
EMAIL_API_KEY=
EMAIL_FROM="Velvet Noise <pedidos@tudominio.com>"
# Alternativa SMTP (si no usas Resend), déjalo vacío si no aplica
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---- Almacenamiento de imágenes (Cloudinary) ------------------------------
# Crea una cuenta gratuita en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seguridad --------------------------------------------------------------
COOKIE_SECRET=
# Orígenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limiting (opcional — Fase 14/15) --------------------------------
# Todas tienen un valor por defecto seguro para producción si se dejan
# vacías (ver backend/src/middlewares/rateLimiters.ts y app.ts). Solo súbelas
# si vas a correr pruebas automatizadas de carga contra un mismo entorno
# (por ejemplo E2E en CI) y el límite normal te bloquea — nunca las subas
# en el .env real de producción sin una razón concreta.
# GLOBAL_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10
# LOGIN_PER_ACCOUNT_RATE_LIMIT_MAX=10
# REFRESH_RATE_LIMIT_MAX=60
# PASSWORD_RESET_RATE_LIMIT_MAX=5

# ---- Frontend (Vite) --------------------------------------------------------
# Estas van en frontend/.env — deben empezar con VITE_ para ser expuestas al navegador
VITE_API_URL=http://localhost:4000/api
VITE_WOMPI_PUBLIC_KEY=
